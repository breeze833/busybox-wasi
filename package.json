{
  "name": "busybox-wasi",
  "version": "1.38.0",
  "description": "BusyBox ash shell and core utilities compiled for WASI Preview 1",
  "type": "module",
  "main": "bin/cli.js",
  "bin": {
    "busybox-wasi": "./bin/cli.js"
  },
  "exports": {
    ".": "./bin/cli.js",
    "./host": "./src/host.js"
  },
  "files": [
    "bin/cli.js",
    "bin/busybox.wasm",
    "src/host.js",
    "README.md",
    "LICENSE",
    "SPEC.md",
    "docs/HOST_FUNCTIONS.md",
    "examples/host-reference.js"
  ],
  "scripts": {
    "build": "./scripts/build.sh",
    "test": "node test/test-applets.js && node test/test-ash.js && node examples/host-reference.js",
    "test:applets": "node test/test-applets.js",
    "test:ash": "node test/test-ash.js",
    "test:host": "node examples/host-reference.js",
    "pack": "mkdir -p dist && npm pack --pack-destination dist/"
  },
  "keywords": [
    "busybox",
    "ash",
    "sh",
    "shell",
    "wasi",
    "wasip1",
    "wasm",
    "webassembly"
  ],
  "license": "GPL-2.0-only"
}
